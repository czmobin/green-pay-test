# نمونهٔ متغیرهای محیطی بک‌اند — این فایل را کپی و مقادیر واقعی را جایگزین کنید.
# روی سرور در /etc/greenpay.env با دسترسی 600 نگهداری می‌شود.
# ⚠️ هرگز مقادیر واقعی (مخصوصاً کلید پیامک) را در مخزن کامیت نکنید.

DJANGO_SETTINGS_MODULE=config.settings
SECRET_KEY=change-me
DEBUG=0
ALLOWED_HOSTS=example.com,localhost,127.0.0.1

# --- پیامک کاوه‌نگار (ورود با کد یک‌بارمصرف) ---
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=contractOtpLogin
OTP_TTL_SECONDS=120
OTP_RESEND_SECONDS=60
# اگر کلید پیامک خالی باشد، کد در پاسخ API برگردانده می‌شود تا ورود در محیط
# توسعه قابل تست باشد. روی production که کلید تنظیم است، بی‌اثر است.
OTP_ECHO_WHEN_SMS_OFF=1
