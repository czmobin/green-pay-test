# نمونهٔ متغیرهای محیطی بک‌اند.
#
# توسعهٔ محلی : این فایل را به backend/.env کپی کنید. مقادیر پیش‌فرضِ همین‌جا
#               برای کار کردن کافی‌اند و نیازی به هیچ کلید واقعی نیست.
# روی سرور    : همین کلیدها در /etc/greenpay.env با دسترسی 600 نگهداری می‌شوند
#               و systemd آن را به‌عنوان EnvironmentFile به سرویس‌ها می‌دهد.
#
# هیچ مقدار واقعی‌ای نباید در مخزن کامیت شود. *.env در .gitignore هست، ولی
# یک بار حواس‌پرتی کافی است — پیش از commit یک بار git diff بگیرید.

DJANGO_SETTINGS_MODULE=config.settings
SECRET_KEY=dev-insecure-change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# روی production حتماً:
#   DEBUG=0
#   ALLOWED_HOSTS=calendar.greenpay360.ir,109.122.252.99,localhost,127.0.0.1
#   CSRF_TRUSTED_ORIGINS=https://calendar.greenpay360.ir
# بدون CSRF_TRUSTED_ORIGINS، فرم ورود پنل ادمین روی https با خطای
# «Origin checking failed» رد می‌شود. (خودِ API با JWT است و CSRF ندارد.)
CSRF_TRUSTED_ORIGINS=
# وقتی همهٔ ترافیک روی https رفت ۱ کنید تا کوکی‌ها فقط روی TLS بروند.
SECURE_COOKIES=0
# فقط برای توسعهٔ محلی روی پورت‌های جدا لازم است؛ در production هم‌دامنه‌ایم.
CORS_ALLOWED_ORIGINS=


# ── دیتابیس ─────────────────────────────────────────────────────────────────
# وجود DB_NAME تعیین می‌کند کدام موتور استفاده شود: تنظیم باشد PostgreSQL،
# خالی باشد SQLite در backend/db.sqlite3. انتخاب عمداً به همین یک متغیر وصل
# است نه به یک پرچم جدا، تا نشود نیمی از مشخصات را تنظیم کرد و پرچم را جا
# انداخت — خطایی که فقط موقع اولین نوشتن خودش را نشان می‌دهد.
#
# توسعهٔ محلی: خالی بگذارید. اگر محیط دقیقاً شبیه production می‌خواهید:
#   docker run -d --name gp-pg -e POSTGRES_DB=greenpay \
#     -e POSTGRES_USER=greenpay -e POSTGRES_PASSWORD=dev -p 5432:5432 postgres:16
# و بعد DB_NAME=greenpay و DB_PASSWORD=dev را پر کنید.
DB_NAME=
DB_USER=greenpay
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
# مدت باز ماندن اتصال (ثانیه). صفر یعنی برای هر درخواست یک اتصال تازه.
DB_CONN_MAX_AGE=60


# ── ورود با کد یک‌بارمصرف (کاوه‌نگار، سرویس Lookup) ─────────────────────────
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=contractOtpLogin
OTP_TTL_SECONDS=120
OTP_RESEND_SECONDS=60
# با کلید خالی پیامکی نمی‌رود و کد در پاسخ API برمی‌گردد تا ورود در محیط توسعه
# ممکن باشد. روی production که کلید تنظیم است بی‌اثر است، ولی محض احتیاط ۰ کنید.
OTP_ECHO_WHEN_SMS_OFF=1


# ── یادآور جلسه و اعلان‌ها (پیشگام رایان، پیامک متن‌آزاد) ────────────────────
PISHGAM_SMS_TOKEN=
PISHGAM_SMS_SENDER=5000391009557
# فاصلهٔ پیش‌فرض یادآور بر حسب دقیقه؛ هر کاربر برای هر جلسه می‌تواند عوضش کند.
MEETING_REMINDER_LEAD_MINUTES=60


# ── همگام‌سازی Outlook (Microsoft Graph، دسترسی app-only) ────────────────────
# تا وقتی OUTLOOK_ENABLED=1 نشود هیچ درخواستی به مایکروسافت نمی‌رود و هیچ جلسه‌ای
# در صف ارسال نمی‌نشیند. مراحل ثبت برنامه در Azure و محدودکردن دسترسی در
# Exchange در DEPLOY.md آمده.
OUTLOOK_ENABLED=0
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_MAIL_DOMAIN=greenpay360.ir
# برای اولین اجرای واقعی روی tenant، فقط یک صندوق آزمایشی را اینجا بگذارید.
# خالی یعنی همهٔ صندوق‌های ثبت‌شده.
OUTLOOK_MAILBOX_ALLOWLIST=
# بازهٔ ثابتِ calendarView. توکن delta بازه را در خودش رمز می‌کند، پس عوض کردن
# این دو، نشانه‌های ذخیره‌شده را باطل و اجرای بعدی را به full-sync تبدیل می‌کند.
OUTLOOK_WINDOW_PAST_DAYS=30
OUTLOOK_WINDOW_FUTURE_DAYS=180
# هر صندوق حداکثر با این فاصله واکشی می‌شود؛ ارسال در هر اجرا انجام می‌شود.
OUTLOOK_PULL_INTERVAL_SECONDS=300
# سقف رخدادهای یک سری تکرارشونده. بدون آن، اولین «استندآپ روزانه» دیتابیس را پر می‌کند.
OUTLOOK_MAX_OCCURRENCES=100
OUTLOOK_HTTP_TIMEOUT=20
# فقط برای تست: مسیر فیکسچرهای JSON به‌جای تماس واقعی با Graph.
OUTLOOK_FAKE_DIR=
